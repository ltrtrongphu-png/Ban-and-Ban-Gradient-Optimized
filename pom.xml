<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.example</groupId>
    <artifactId>BaB</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>BaB</name>
    <description>Ban and Ban - AntiCheat heuristic (he thong VL) + AntiSpam, ban qua LiteBans</description>
    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Gia tri mac dinh khi build khong chi dinh profile (vd IDE bam Run) -->
        <paper.api.version>1.21.11-R0.1-SNAPSHOT</paper.api.version>
        <output.name>BaB</output.name>
    </properties>
    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>dmulloy2-repo</id>
            <url>https://repo.dmulloy2.net/repository/public/</url>
        </repository>
        <!-- PacketEvents duoc build/publish qua CodeMC. Neu ban dung dung ban
             SNAPSHOT (nhu jar da upload: 2.13.1-SNAPSHOT), can repo snapshots;
             neu chuyen sang 1 ban release chinh thuc thi dung maven-releases. -->
        <repository>
            <id>codemc-snapshots</id>
            <url>https://repo.codemc.io/repository/maven-snapshots/</url>
        </repository>
        <repository>
            <id>codemc-releases</id>
            <url>https://repo.codemc.io/repository/maven-releases/</url>
        </repository>
    </repositories>
    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.comphenix.protocol</groupId>
            <artifactId>ProtocolLib</artifactId>
            <version>5.3.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.45.3.0</version>
        </dependency>
        <!-- PacketEvents: them SONG SONG voi ProtocolLib (khong thay the). Dung
             scope "compile" (mac dinh) vi khac voi ProtocolLib, PacketEvents
             thuong duoc SHADE (dong goi) truc tiep vao jar cua tung plugin thay
             vi cai rieng tren server - xem phan relocation ben duoi de tranh
             xung dot neu server co nhieu plugin cung shade PacketEvents nhung
             khac phien ban. NEU build bao loi khong tim thay dependency nay (vi
             du do server/CI khong ra duoc internet toi repo.codemc.io), co the
             thay bang scope "system" tro toi file .jar da upload, hoac chay:
               mvn install:install-file -Dfile=packetevents-spigot-2.13.1-SNAPSHOT.jar \
                 -DgroupId=com.github.retrooper -DartifactId=packetevents-spigot \
                 -Dversion=2.13.1-SNAPSHOT -Dpackaging=jar
             de nap thu cong vao local repo (~/.m2) truoc khi build. -->
        <dependency>
            <groupId>com.github.retrooper</groupId>
            <artifactId>packetevents-spigot</artifactId>
            <version>2.13.1-SNAPSHOT</version>
        </dependency>
        <!-- Dung de doc log console cua plugin CheckHacks (CheckHacksBridge). Scope
             "provided" vi Paper server da co san log4j-core luc chay - KHONG duoc
             dong goi trung vao jar cua BaB, neu khong se pha he thong log ca server. -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.19.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- JUnit 5: chi dung cho unit test (src/test/java) tren logic thuan tuy
             (khong phu thuoc Bukkit server) nhu StatsUtil, GradientUtil. Scope
             "test" nen KHONG bi dong goi vao jar cuoi cung cua plugin. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <finalName>${output.name}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <!-- Surefire ban moi de chay duoc test JUnit 5 (junit-platform) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- Doi package noi bo cua PacketEvents khi dong goi vao jar cua BaB,
                                 de tranh xung dot neu server cai them 1 plugin KHAC cung shade
                                 PacketEvents nhung khac phien ban (2 ban PacketEvents khac nhau
                                 tren cung classpath se loi runtime kho debug neu khong relocate). -->
                            <relocations>
                                <relocation>
                                    <pattern>com.github.retrooper.packetevents</pattern>
                                    <shadedPattern>com.example.bab.libs.packetevents</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>io.github.retrooper.packetevents</pattern>
                                    <shadedPattern>com.example.bab.libs.packetevents.impl</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- OBFUSCATE: chay SAU shade (list SAU trong <plugins>, cung phase "package" -
                 Maven thuc thi theo THU TU khai bao khi cung 1 phase), lam viec tren jar DA
                 shade (${output.name}.jar) de dong goi 1 lan duy nhat roi moi lam roi ten.
                 CHI lam roi ten CLASS/METHOD cua code BaB (com.example.bab.**), KHONG dung
                 toi cac thu vien dong goi kem (org.sqlite.**, com.example.bab.libs.** - ban
                 PacketEvents da doi ten o buoc shade o tren) vi cac thu vien nay dung nhieu
                 reflection/JDBC driver-loading noi bo, doi ten co the lam vo hoat dong ma
                 khong bao loi bien dich (chi loi runtime, rat kho debug tren server that).
                 Dung -dontshrink/-dontoptimize (CHI doi ten, khong xoa/toi uu code) de giam
                 toi da rui ro pha vo logic ma minh khong the bien dich-kiem tra trong sandbox
                 nay (thieu quyen mang toi Maven Central/repo Paper) - BAN CAN tu chay
                 "mvn package" va TEST KY tren server that truoc khi dung ban da obfuscate
                 cho production. -->
            <plugin>
                <groupId>com.github.wvengen</groupId>
                <artifactId>proguard-maven-plugin</artifactId>
                <version>2.6.0</version>
                <!-- FIX (loi that tu log build CI ban gui): proguard-maven-plugin 2.6.0 mac
                     dinh keo theo com.guardsquare:proguard-base 7.2.2, ban nay CHI doc duoc
                     bytecode toi Java 18 (class file version 62) - trong khi pom.xml nay bien
                     dich bang Java 21 (class file version 65), gay loi "Unsupported version
                     number [65.0]". Ghi de len phien ban proguard-base/proguard-core moi hon
                     (7.4.0+ moi ho tro doc class Java 21) de sua dut diem. -->
                <dependencies>
                    <dependency>
                        <groupId>com.guardsquare</groupId>
                        <artifactId>proguard-base</artifactId>
                        <version>7.7.0</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>proguard</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <injar>${output.name}.jar</injar>
                    <outjar>${output.name}-obf.jar</outjar>
                    <outputDirectory>${project.build.directory}</outputDirectory>
                    <obfuscate>true</obfuscate>
                    <options>
                        <option>-dontshrink</option>
                        <option>-dontoptimize</option>
                        <option>-dontwarn **</option>
                        <option>-ignorewarnings</option>
                        <option>-keepattributes *Annotation*,Signature,InnerClasses,Exceptions</option>
                        <!-- Ten class chinh PHAI giu nguyen vi plugin.yml (main: com.example.bab.BaB)
                             tham chieu toi no bang STRING - ProGuard khong biet doc plugin.yml. -->
                        <option>-keep public class com.example.bab.BaB { public *; }</option>
                        <!-- Cac phuong thuc @EventHandler duoc Bukkit tim BANG REFLECTION dua tren
                             ANNOTATION (khong phai ten), nen VE LY THUYET khong can giu ten - nhung
                             giu lai cho AN TOAN TUYET DOI (khong co moi truong that de kiem chung
                             trong sandbox nay). -->
                        <option>-keepclassmembers class * implements org.bukkit.event.Listener { @org.bukkit.event.EventHandler *; }</option>
                        <option>-keep class * implements org.bukkit.command.CommandExecutor { *; }</option>
                        <option>-keep class * implements org.bukkit.command.TabCompleter { *; }</option>
                        <option>-keepclassmembers enum * { public static **[] values(); public static ** valueOf(java.lang.String); }</option>
                        <!-- KHONG dong toi thu vien dong goi kem (giu nguyen 100%, xem giai thich o comment pom.xml). -->
                        <option>-keep class org.sqlite.** { *; }</option>
                        <option>-keep class com.example.bab.libs.** { *; }</option>
                    </options>
                    <libs>
                        <lib>${java.home}/jmods/java.base.jmod</lib>
                    </libs>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <!--
      2 profile de build rieng cho 2 server khac phien ban:
        mvn -B package -P paper-1.21.4   -> tao target/BaB-1.21.4.jar
        mvn -B package -P paper-1.21.11  -> tao target/BaB.jar
      Neu chay "mvn package" khong chi dinh -P, profile paper-1.21.11 se tu
      duoc dung (activeByDefault) va tao ra target/BaB.jar nhu truoc gio.
    -->
    <profiles>
        <profile>
            <id>paper-1.21.4</id>
            <properties>
                <paper.api.version>1.21.4-R0.1-SNAPSHOT</paper.api.version>
                <output.name>BaB-1.21.4</output.name>
            </properties>
        </profile>
        <profile>
            <id>paper-1.21.11</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <paper.api.version>1.21.11-R0.1-SNAPSHOT</paper.api.version>
                <output.name>BaB</output.name>
            </properties>
        </profile>
    </profiles>
</project>
